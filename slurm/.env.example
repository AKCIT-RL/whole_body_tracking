# Copy to  $RUN_DIR/.env   (default: /raid/$USER/wbt_lowpass/.env)  and fill in.
# Loaded into every container via  apptainer --env-file  (isaac-arenas pattern).
# NEVER commit the filled version.  chmod 600 it.

# --- Weights & Biases -------------------------------------------------
# key from https://wandb.ai/authorize
WANDB_API_KEY=

# your W&B *organization* (not a personal username).
# Can also be passed on submit:  sbatch --export=ALL,WANDB_ENTITY=<org> ...
WANDB_ENTITY=

# optional: silence the wandb "using legacy service" chatter
WANDB_SILENT=true

# --- Isaac Sim -------------------------------------------------------
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y
